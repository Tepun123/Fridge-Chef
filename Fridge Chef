import os
import requests
from dotenv import load_dotenv

# Import the functions from your brand-new database.py file!
import database

# Load variables from .env
load_dotenv()
SPOONACULAR_API_KEY = os.getenv("SPOONACULAR_API_KEY")


def get_recipes_by_ingredients(ingredients_list):
    """Fetches recipes using the Spoonacular 'findByIngredients' endpoint."""
    url = "https://api.spoonacular.com/recipes/findByIngredients"
    ingredients_string = ",".join(ingredients_list)
    
    params = {
        "apiKey": SPOONACULAR_API_KEY,
        "ingredients": ingredients_string,
        "number": 5,           
        "ranking": 1,          
        "ignorePantry": True   
    }

    try:
        response = requests.get(url, params=params)
        if response.status_code == 200:
            return response.json()
        else:
            print(f"Error: {response.status_code}")
            return None
    except Exception as e:
        print(f"An error occurred: {e}")
        return None


# --- Execution Block ---
if __name__ == "__main__":
    # 1. Call the database functions using the 'database.' prefix
    database.init_database()
    database.create_user("Tepun")
    print("-" * 30)

    # 2. Run your recipe search logic
    my_ingredients = ["chicken", "spinach", "garlic", "heavy cream"]
    print(f"Searching for recipes using: {', '.join(my_ingredients)}...\n")
    results = get_recipes_by_ingredients(my_ingredients)

    if results:
        # Grab the top recipe to test our history logger
        first_recipe = results[0]
        print(f"Top choice found: {first_recipe['title']} (ID: {first_recipe['id']})")
        
        # 3. Log the recipe to User #1's history in the other file!
        database.log_cooked_recipe(user_id=1, recipe_id=first_recipe['id'], recipe_title=first_recipe['title'])
        print("-" * 30)
    else:
        print("No recipes found or there was an issue with the API call.")