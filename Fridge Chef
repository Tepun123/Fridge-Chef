import requests
import os
from dotenv import load_dotenv

# Load variables from .env
load_dotenv()
SPOONACULAR_API_KEY = os.getenv("SPOONACULAR_API_KEY")

# Temporary debug lines:


def get_recipes_by_ingredients(ingredients_list):
    """
    Fetches recipes using the Spoonacular 'findByIngredients' endpoint.
    """
    url = "https://api.spoonacular.com/recipes/findByIngredients"
    
    # Format ingredients for the API (comma-separated string)
    ingredients_string = ",".join(ingredients_list)
    
    # Parameters for the API call
    params = {
        "apiKey": SPOONACULAR_API_KEY,
        "ingredients": ingredients_string,
        "number": 5,           # Number of recipes to return
        "ranking": 1,          # 1 = Maximize used ingredients, 2 = Minimize missing
        "ignorePantry": True   # Ignore common items like water, salt, etc.
    }

    try:
        response = requests.get(url, params=params)
        
        # Check for successful response
        if response.status_code == 200:
            recipes = response.json()
            return recipes
        else:
            print(f"Error: {response.status_code}")
            print(response.text)
            return None
            
    except Exception as e:
        print(f"An error occurred: {e}")
        return None

# --- Test Execution ---
if __name__ == "__main__":
    # Your hardcoded list of ingredients
    my_ingredients = ["chicken", "spinach", "garlic", "heavy cream"]

    print(f"Searching for recipes using: {', '.join(my_ingredients)}...\n")
