import os
import requests
from dotenv import load_dotenv
import database

# Load variables from .env
load_dotenv()
SPOONACULAR_API_KEY = os.getenv("SPOONACULAR_API_KEY")


def get_recipes_by_ingredients(ingredients_list):
    """Fetches recipes using the Spoonacular 'findByIngredients' endpoint."""
    url = "https://api.spoonacular.com/recipes/findByIngredients"
    ingredients_string = ",".join(ingredients_list)
    
    params = {
        "apiKey": SPOONACULAR_API_KEY,
        "ingredients": ingredients_string,
        "number": 3,           # Reduced to 3 for cleaner terminal printing
        "ranking": 1,          
        "ignorePantry": True   
    }

    try:
        response = requests.get(url, params=params)
        if response.status_code == 200:
            return response.json()
        else:
            print(f"API Error: {response.status_code}")
            return None
    except Exception as e:
        print(f"An error occurred: {e}")
        return None


# --- Interactive Terminal Loop ---
if __name__ == "__main__":
    database.init_database()
    database.create_user("Tepun")
    USER_ID = 1  # We are acting as Tepun (User #1)
    
    print("\n=== Welcome to Minimalist Fridge Chef ===")
    
    while True:
        print("\n[ MENU ]")
        print("1. View your fridge items")
        print("2. Add an ingredient to your fridge")
        print("3. Search recipes using your fridge ingredients")
        print("4. Exit")
        
        choice = input("\nChoose an option (1-4): ").strip()
        print("-" * 40)
        
        if choice == "1":
            fridge = database.get_user_ingredients(USER_ID)
            if fridge:
                print("Your fridge currently contains:")
                for item in fridge:
                    print(f" - {item}")
            else:
                print("Your virtual fridge is empty!")
                
        elif choice == "2":
            new_food = input("Type the ingredient you want to add: ")
            if new_food:
                database.add_ingredient(USER_ID, new_food)
            else:
                print("Ingredient name cannot be blank.")
                
        elif choice == "3":
            fridge = database.get_user_ingredients(USER_ID)
            if not fridge:
                print("You can't search for recipes with an empty fridge! Add items first.")
                continue
                
            print(f"Searching Spoonacular using your database items: {', '.join(fridge)}...\n")
            results = get_recipes_by_ingredients(fridge)
            
            if results:
                for i, recipe in enumerate(results, 1):
                    print(f"{i}. {recipe['title']} (ID: {recipe['id']})")
                    if recipe['missedIngredients']:
                        missing = [item['name'] for item in recipe['missedIngredients']]
                        print(f"   Missing items: {', '.join(missing)}")
                    print("." * 30)
                
                # Ask if they want to save their top result to their history log
                log_choice = input("\nWhich recipe do you want to mark as cooked? (Enter number): ").lower().strip()
                if log_choice: # If they didn't just hit Enter to skip
                    try:
                        # Convert their text input (e.g., "2") into a number and subtract 1 for Python index (e.g., 1)
                        recipe_index = int(log_choice) - 1

                        if 0 <= recipe_index < len(results):
                            selected_recipe = results[recipe_index]
                            database.log_cooked_recipe(USER_ID, selected_recipe['id'], selected_recipe['title'])
                    except ValueError:
                        print("Please enter a valid recipe number.")

            else:
                print("No recipes found or API error.")
                
        elif choice == "4":
            print("Goodbye Chef!")
            break
            
        else:
            print("Invalid choice, please select 1, 2, 3, or 4.")
        print("-" * 40)